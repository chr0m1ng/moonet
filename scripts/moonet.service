[Unit]
Description=Moonet Backend Service
After=network-online.target bluetooth.service bt-auto-connect.service bt-keepalive.service
Wants=network-online.target bluetooth.service bt-auto-connect.service bt-keepalive.service

[Service]
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native
User=pi
WorkingDirectory=/home/pi/moonet
ExecStart=poetry run gunicorn -w 1 -b 0.0.0.0:8080 wsgi:app
Restart=always
RestartSec=3
Environment="PYTHONUNBUFFERED=1"
Environment="PATH=/home/pi/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket"

[Install]
WantedBy=multi-user.target
